# ============================================================
#  AGENCIA CRM — .env de ejemplo (desarrollo local)
#  Copiar a .env en la raíz del fork. NUNCA committear el .env real.
#  Reemplazar: agencia, dominios y contraseñas.
# ============================================================

# --- Identidad ---
FRONTEND_URL=http://localhost:3001
DEFAULT_LOCALE=es

# --- Base de datos (en compose, el servicio se llama postgres) ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DATABASE=chatwoot
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=cambiar-en-local

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=cambiar-en-local

# --- Rails ---
SECRET_KEY_BASE=generar-con-bin-rails-secret
RAILS_ENV=development
NODE_ENV=development

# --- Correo (Mailhog local) ---
MAILER_SENDER_EMAIL=CRM Agencia <noreply@localhost>
SMTP_ADDRESS=mailhog
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=

# --- Active Storage (adjuntos) ---
# Dev: disco local. Prod: S3-compatible (ver deploy/README.md)
ACTIVE_STORAGE_SERVICE=local

# --- Verificación de que NO estás usando código enterprise ---
# El CI falla si el runtime carga enterprise/. Esto queda como recordatorio:
# no activar flags ni rutas de enterprise/ en el CE.
